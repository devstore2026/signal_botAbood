BOT_TOKEN=
PO_WS_URL=wss://demo-api-eu.po.market/socket.io/?EIO=4&transport=websocket
# Full demo auth frame. Keep it local/Render Secrets; never share it.
PO_AUTH_FRAME=
# Optional fixed recipients (comma separated Telegram chat IDs)
ALERT_CHAT_IDS=
# If set, only these Telegram user IDs can control scanner commands.
ALLOWED_USER_IDS=
# PRE_CLOSE: scan at :57 for next :00 (C1 is explicitly provisional).
# CLOSED: scan after :00 using fully closed C1 (cannot promise a pre-:59 alert).
SCAN_MODE=PRE_CLOSE
SCAN_SECOND=57
SEND_DEADLINE_SECOND=59
MIN_PAYOUT=85
MIN_CONFIDENCE=80
MAX_SIGNALS_PER_MINUTE=1
PAYOUT_TTL=120
MAX_TICK_AGE=2
MAX_TICK_GAP=5
MAX_OPEN_DELAY=2
MAX_CLOSE_DELAY=2
MIN_CANDLE_TICKS=10
CANDLE_HISTORY=180
# Generic asset payout is NOT assumed to be M1 unless explicitly confirmed.
GENERIC_PAYOUT_IS_M1=false
# For positional updateAssets rows, set VERIFIED indices, e.g. symbol/name/payout/active.
ASSET_ARRAY_MAP={}
SUBSCRIBE_EVENT=subscribeSymbol
SUBSCRIBE_AS_OBJECT=false
SUBSCRIBE_PERIOD=60
ASSET_REFRESH_EVENT=getAssets
ASSET_REFRESH_SECONDS=30
# Optional local verified calendar file; unknown news earns 0 news points.
NEWS_FILE=
NEWS_MAX_AGE=300
NEAR_LEVEL_FRACTION=0.20
MAX_BB_EXPANSION=1.15
MAX_EMA_SLOPE_FRACTION=0.08

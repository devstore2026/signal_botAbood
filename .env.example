# Insert a NEW token from BotFather locally. Never share tokens.
BOT_TOKEN=
PO_WS_URL=wss://demo-api-eu.po.market/socket.io/?EIO=4&transport=websocket
# Paste the full demo auth frame locally if the price feed requires login.
# Example: 42["auth",{"session":"...","isDemo":1,"uid":123,"platform":1}]
PO_AUTH_FRAME=
MIN_TICKS=80
TICK_BUFFER_SIZE=20000
MAX_TICK_AGE=2
MIN_SCORE=4
MIN_EFFICIENCY=0.30
LOSSLESS_UI_DELAY=0
MIN_STATS_SAMPLE=50
PAPER_MAX_GAP=2
SIGNAL_COOLDOWN=5

# Your Render service URL for keep-alive (no trailing slash)
SELF_URL=https://your-service.onrender.com
